# Copy to .env (gitignored) and fill in. Use dedicated test accounts only: the tests give them
# software passkeys, issue them helpdesk tokens and replace their recovery codes.

# A member of the helpdesk group (HELPDESK_GROUP_DN), or named in HELPDESK_ALLOWED_DNS
E2E_AGENT_ID=pktest-agent
E2E_AGENT_PASSWORD=

# Not in the helpdesk group
E2E_USER_ID=pktest-user
E2E_USER_PASSWORD=

# Optional: a disabled account, for checking that passwordless sign-in refuses it. It has to be
# enabled once while the tests give it a software passkey (the password is only needed then);
# see the README.
# E2E_DISABLED_ID=disabledTest
# E2E_DISABLED_PASSWORD=

# Optional: check notification emails (NOTIFY_EMAIL=true) through MailCatcher. Set this to the
# test user's mail value.
# E2E_USER_MAIL=pktest-user@namapp1.test
# E2E_MAILCATCHER_URL=http://localhost:1080

# Optional: the DNs as NAM logs them, if they aren't cn=<ID>,...
# E2E_AGENT_DN=cn=pktest-agent,o=novell
# E2E_USER_DN=cn=pktest-user,o=novell

# Optional: the test accounts, created from fixtures/test-accounts.ldif with
# `npm run accounts -- load`. The user store's eDirectory, an admin that can create users there, and
# the containers for users and the helpdesk group (cn=pktest-helpdesk, the HELPDESK_GROUP_DN). Without
# the password, ldapmodify asks for it. E2E_LDAP_CACERT is the tree's CA, for checking the server.
# E2E_LDAP_URL=ldaps://idm.example.test
# E2E_LDAP_ADMIN_DN=cn=admin,ou=sa,o=system
# E2E_LDAP_ADMIN_PASSWORD=
# E2E_LDAP_USERS=ou=users,o=data
# E2E_LDAP_GROUPS=ou=groups,o=data
# E2E_LDAP_CACERT=.state/ldap-ca.pem
# Where the questions method's QUESTIONS_SSPR_ATTRIBUTE points
# E2E_SSPR_ATTRIBUTE=carLicense

# Defaults shown
# E2E_BASE_URL=https://namapp1.pointbluetech.com
# E2E_SSH=root@192.168.201.90
# E2E_LOG=/opt/novell/nam/idp/logs/catalina.out  (needs Echo to Console on the Identity Server)
# E2E_CONTRACT_MANAGE=PasskeyManage
# E2E_CONTRACT_RECOVERY=PasskeyRecovery
# E2E_CONTRACT_HELPDESK=PasskeyHeldesk
# E2E_CONTRACT_LOGIN=PasskeyLogin
# Optional: the Authentication Card ID (the main.jsp?id= value, not the contract's name or URI) of
# a LOGIN contract whose method has PASSKEY_ONLY=true, for the fallback test
# E2E_CONTRACT_PASSKEY_ONLY=PasskeyLoginOnly
# Optional: the first-passkey email check. A contract of Name/Password, then a MANAGE method with
# ENROLL_GATES=email; an account that has no passkey (the test leaves it with none); and that
# account's mail value.
# E2E_CONTRACT_GATED=PasskeyGated
# E2E_ENROLL_ID=pktest-enroll
# E2E_ENROLL_PASSWORD=
# E2E_ENROLL_MAIL=pktest-enroll@namapp1.test
# Optional: the security-questions check, on the same account. A contract of Name/Password, then a
# MANAGE method with ENROLL_GATES=questions and QUESTIONS_SSPR_ATTRIBUTE set to where
# e2e/fixtures/sspr-responses.ldif puts the answers.
# E2E_CONTRACT_QUESTIONS=PasskeyQuestions
# Optional: the same check against NMAS (QUESTIONS_STORE=nmas), with the same questions and answers
# set in NMAS for the account.
# E2E_CONTRACT_QUESTIONS_NMAS=PasskeyQuestionsNmas
# E2E_MAX_FAILED=5
# Set to RECOVERY_COOLDOWN_SEC when it's set on the passkey class, to check the cool-down. The
# tests wait it out after each recovery, so use something short such as 30.
# E2E_RECOVERY_COOLDOWN_SEC=0
# E2E_BROWSER_CHANNEL=chrome
