# Settings for amcli-deploy.sh. Copy to amcli.env, fill it in, keep it private (it holds a password
# and the recovery pepper), and run:   AMCLI_ENV_FILE=amcli.env ./amcli-deploy.sh all

# The Administration Console and an administrator (see amcli's .env.example for the rest)
AMCLI_URL=https://ac.example.com:8443
AMCLI_USER=admin
AMCLI_PASSWORD=
# AMCLI_CA_FILE=/path/to/console-ca.pem
# AMCLI_TLS_SERVERNAME=ac.example.com
# AMCLI_CLUSTER=IDP-Cluster

# The passkey class (see the README's Configuration section)
PASSKEY_RP_ID=login.example.com
PASSKEY_ORIGINS=https://login.example.com
# At least 32 random characters; generate one with: openssl rand -base64 48
PASSKEY_RECOVERY_PEPPER=

# The user store the methods use, by its name in Administration Console
PASSKEY_USER_STORE=

# The password method that comes before the passkey in the MFA, Manage and Recovery contracts
# PASSKEY_PASSWORD_METHOD=Secure Name/Password - Form

# Set it to add the helpdesk method and contract (amcli/passkey-helpdesk.json)
# PASSKEY_HELPDESK_GROUP_DN=cn=passkey-helpdesk,ou=groups,o=example
